# IDE settings (developer-specific IntelliJ/JetBrains configs)
.idea
.run

# Postgres data directory created by the dev docker-compose stack
db/data

# static directory artifacts (compiled frontend assets and vendored modules)
static/               # mkdocs or other asset dumps
web/dist/             # Vite build output for React Admin
**/node_modules/      # installed dependencies
.pnpm-store/          # pnpm shared store created during installs

# package manager locks (pnpm) – generated locally but not used in this workspace
**/pnpm-lock.yaml

# environment files (contain developer-specific secrets)
**/.env

# built binary file emitted by go build
/argo-watcher

# Swagger spec (generated by swag init into web/public for Vite bundling)
web/public/swagger/swagger.json

# Swagger spec copy used by the docs site (generated by docs/scripts/build-swagger.sh)
docs/reference/swagger.json

# code coverage files/directories created by go/vitest coverage jobs
**/coverage.*
**/coverage/

# Taskfile cache (genny metadata)
.task/

# dynamically generated mocks (task mocks regenerates them)
internal/mocks/

# goreleaser artifacts (tarballs, binaries)
dist/

# generated docs for mkdocs publish
site/

# mkdocs cache (build acceleration)
.cache/

# sandbox directory for experiments and scratch work
sandbox/

# per-phase JUnit reports written by the e2e lab's bats run
test/e2e/reports/

# Playwright run output (HTML report, traces, screenshots)
web/playwright-report/
web/test-results/

# TypeScript incremental build info (emitted by the composite node-side project)
**/*.tsbuildinfo
