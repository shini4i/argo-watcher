{
  "name": "argo-watcher-react-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck:e2e": "tsc -p tsconfig.node.json --noEmit",
    "scan:js": "retire --path . --ext js,mjs --severity low --ignore dist,coverage,playwright-report,test-results"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.7",
    "react-admin": "^5.15.1",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.23",
    "retire": "^5.7.0",
    "swagger-ui-dist": "^5.32.14",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "lodash": "^4.17.21",
    "ra-core": "5.15.0",
    "ra-ui-materialui": "5.15.1",
    "ra-i18n-polyglot": "5.15.0",
    "ra-language-english": "5.15.0"
  }
}
