{
  "name": "argo-watcher-react-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.node.json --noEmit",
    "scan:js": "retire --path . --ext js,mjs --severity low --ignore dist,coverage,playwright-report,test-results"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-admin": "^5.15.5",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "retire": "^6.1.0",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "lodash": "^4.17.21",
    "ra-core": "5.15.5",
    "ra-ui-materialui": "5.15.5",
    "ra-i18n-polyglot": "5.15.5",
    "ra-language-english": "5.15.5"
  }
}
